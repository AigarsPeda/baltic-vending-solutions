# Copy to scripts/baltic-vending-solutions.env. The real file is ignored by Git.
# Every setting is intentionally blank. Use quoted absolute paths.
# Local paths come from this site's Local App runtime, not another site.
SSH_KEY=""
REMOTE_HOST=""
REMOTE_WP_PATH=""
REMOTE_URL=""
REMOTE_BACKUP_DIR=""
LOCAL_URL=""
LOCAL_WP_PATH=""
LOCAL_PHP_BIN=""
LOCAL_PHP_INI=""
LOCAL_WP_CLI=""
LOCAL_MYSQL_BIN_DIR=""
LOCAL_MYSQL_SOCKET=""
BACKUP_DIR=""
# Optional positive integer. Scripts default to keeping 3 database backups.
BACKUP_KEEP=""
# Optional repository theme override. Otherwise theme/baltic-vending-solutions.
LOCAL_THEME_PATH=""
